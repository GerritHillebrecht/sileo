{
  "name": "sileo",
  "version": "0.1.6",
  "description": "An opinionated, physics based toast notification library for react.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiaaryan/sileo.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && bunchee && cp src/styles.css dist/styles.css",
    "dev": "bunchee --watch",
    "test": "vitest run",
    "pack:oneserve": "bun run build && node scripts/pack-oneserve.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "bunchee": "^6.9.4",
    "happy-dom": "21.0.3",
    "motion": "14.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "motion": "^14.7.1",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
